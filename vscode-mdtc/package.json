{
  "name": "mdtc-lsp",
  "displayName": "MdtC Language Support",
  "description": "MdtC (.mdtc) language server: diagnostics, completion, formatting, hover. Compiles to Mindustry logic.",
  "version": "0.1.0",
  "publisher": "mdtc",
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:mdtc",
    "onLanguage:mdtcode"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mdtc",
        "aliases": [
          "MdtC",
          "mdtc"
        ],
        "extensions": [
          ".mdtc",
          ".libmdtc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mdtcode",
        "aliases": [
          "MdtCode",
          "mdtcode"
        ],
        "extensions": [
          ".mdtcode"
        ]
      }
    ],
    "configuration": {
      "title": "MdtC",
      "properties": {
        "mdtc.lsp.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP trace level (written to the MdtC LSP Trace output channel)."
        },
        "mdtc.lsp.watch": {
          "type": "boolean",
          "default": false,
          "description": "Dev mode: restart the TS language server automatically when its source changes."
        }
      }
    },
    "grammars": [
      {
        "language": "mdtc",
        "scopeName": "source.mdtc",
        "path": "./syntaxes/mdtc.tmLanguage.json"
      },
      {
        "language": "mdtcode",
        "scopeName": "source.mdtcode",
        "path": "./syntaxes/mdtcode.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:server && tsc -p ./",
    "watch": "cd server && tsc -w -p .",
    "package": "vsce package --out mdtc-lsp-0.1.0.vsix",
    "prepare:data": "node scripts/prepare-data.mjs",
    "compile:server": "cd server && tsc -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  },
  "files": [
    "out/**",
    "server/out/**",
    "server/data/**",
    "server/node_modules/**",
    "language-configuration.json",
    "syntaxes/**",
    "node_modules/**"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/576576/mdtc-lsp.git"
  }
}