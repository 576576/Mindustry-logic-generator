  "mod": {
    "browser_title": "From Mod Browser",
    "browser_step1": "In Mindustry, go to **Mods** → **Mod Browser**",
    "browser_step2": "Search for **MdtC** → **Install**",
    "browser_step3": "Open any processor → click **MdtC** at the bottom toolbar",
    "browser_step4": "Edit `.mdtc` in the left pane, preview `.mdtcode` in the right pane",
    "manual_title": "Manual Import",
    "manual_step1": "[Download](https://github.com/576576/mdtC/releases) `mdtc-{version}-Desktop.jar`",
    "manual_step2": "In Mindustry, go to **Mods** → **Import Mod** → select the JAR file",
    "manual_step3": "Then same as steps 3–4 above"
  },
