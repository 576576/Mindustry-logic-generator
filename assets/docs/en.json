  "_comment_contrib": "── Contributing a Translation ──",
  "contrib": {
    "step1": "Copy `assets/bundles/en.properties` to `assets/bundles/[langCode]-[regionCode].properties`",
    "step2": "Translate all values — **keys must stay unchanged**",
    "step3": "(Optional) Copy `assets/docs/en.json` to `assets/docs/[langCode].json` and translate the documentation",
    "step4": "Submit a Pull Request — CI will auto-update [docs/i18n.md]({{docs_root}}i18n.md) on merge"
  },
